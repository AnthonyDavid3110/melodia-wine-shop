# Melodia Wine Shop — environment variables
#
# Copy this file to .env.local for local development.
# Never commit real values. See src/lib/env.ts for validation.
#
# NODE_ENV is provided automatically by Next.js; it does not need to be set here.
#
# Variables required by future phases (database, authentication, payments,
# email, storage) will be added here as those phases are implemented.
