# Melodia Wine Shop — environment variables
#
# Copy this file to .env.local for local development.
# Never commit real values. See src/lib/env.ts for validation.
#
# NODE_ENV is provided automatically by Next.js; it does not need to be set here.
#
# Variables required by future phases (authentication, payments, email,
# storage) will be added here as those phases are implemented.

# --- Database ---------------------------------------------------------
#
# Development: `docker compose up -d` starts a local PostgreSQL
# container (see compose.yaml). Both URL variables below can point at
# that same local database — local Postgres does not have Neon's
# separate pooled/direct endpoints, so there is nothing to distinguish
# locally:
#
# DATABASE_URL=postgresql://melodia:melodia_dev_only@localhost:5432/melodia_dev
# DATABASE_URL_UNPOOLED=postgresql://melodia:melodia_dev_only@localhost:5432/melodia_dev
# DATABASE_DRIVER=postgres
#
# Production: DATABASE_URL/DATABASE_URL_UNPOOLED come from the Neon
# console once a project exists. DATABASE_URL is the pooled connection
# (hostname contains "-pooler") — used by the application at runtime.
# DATABASE_URL_UNPOOLED is the direct connection — used only by
# drizzle-kit (migrations) and the seed script; using the pooled string
# for migrations can cause errors.
#
# DATABASE_DRIVER=neon
#
# DATABASE_DRIVER selects the database driver EXPLICITLY — it is never
# inferred from the hosting platform. Hosting (Vercel) and database
# provider (Neon) are separate concerns. Allowed values: "postgres"
# (drizzle-orm/node-postgres — local Docker, tests) or "neon"
# (drizzle-orm/neon-serverless — Neon). Neon is never required for
# local development.

DATABASE_URL=

DATABASE_URL_UNPOOLED=

DATABASE_DRIVER=

# --- Authentication (Better Auth, Phase 3) -----------------------------
#
# Development: any fixed non-secret value works — this only signs
# sessions against a local, throwaway database.
#
# BETTER_AUTH_SECRET=dev-only-not-a-real-secret-do-not-use-in-production
# BETTER_AUTH_URL=http://localhost:3000
#
# Production: BETTER_AUTH_SECRET must be freshly generated (e.g.
# `openssl rand -base64 32`) and set only in the deployment platform's
# secret manager — never committed, never reused from development.
# BETTER_AUTH_URL=https://vins.ecmelodia.ch

BETTER_AUTH_SECRET=

BETTER_AUTH_URL=

# --- Payments (Saferpay JSON API, Phase 10 Gate 10B) -------------------
#
# Development: use the official Saferpay TEST environment. The
# CustomerId and TerminalId below are not secrets, but the API
# username/password ARE secrets — the project owner populates them only
# in .env.local, never here, never in chat.
#
# SAFERPAY_ENVIRONMENT=test
# SAFERPAY_CUSTOMER_ID=<your Saferpay customer number>
# SAFERPAY_TERMINAL_ID=<your Saferpay eCommerce terminal number>
#
# SAFERPAY_API_USERNAME and SAFERPAY_API_PASSWORD come from the
# Saferpay Backoffice under Settings > JSON API basic authentication.
# They are separate raw credential components (never a precomputed
# "Authorization: Basic ..." header) — the application constructs the
# Basic Authentication header itself, server-side only.
#
# Production: SAFERPAY_ENVIRONMENT=live, plus production Customer/
# Terminal/API credentials once the ECM merchant account and contract
# are finalized (docs/08-PAYMENTS.md §65) — a deployment dependency,
# not an architecture decision.

SAFERPAY_ENVIRONMENT=

SAFERPAY_CUSTOMER_ID=

SAFERPAY_TERMINAL_ID=

SAFERPAY_API_USERNAME=

SAFERPAY_API_PASSWORD=
